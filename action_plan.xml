<?xml version="1.0" encoding="UTF-8"?>
<migration_plan>
  <metadata>
    <project>moon_flutter_core</project>
    <from_version>mix_v1</from_version>
    <to_version>mix_v2</to_version>
    <breaking_changes>true</breaking_changes>
    <estimated_tasks>45</estimated_tasks>
    <created_date>2025-09-22</created_date>
  </metadata>

  <prerequisites>
    <task id="P1" priority="critical">
      <title>Update Mix dependency</title>
      <description>Update pubspec.yaml to use Mix v2</description>
      <files>
        <file>pubspec.yaml</file>
        <file>example/pubspec.yaml</file>
      </files>
      <changes>
        <change>Replace git dependency with: mix: ^2.0.0</change>
      </changes>
    </task>
    
    <task id="P2" priority="critical">
      <title>Enable dot notation syntax</title>
      <description>Add experimental feature flag for dot notation</description>
      <files>
        <file>analysis_options.yaml</file>
        <file>example/analysis_options.yaml</file>
      </files>
      <changes>
        <change>Add under analyzer: enable-experiment: - dot-shorthands</change>
      </changes>
      <note>Requires Dart SDK >= 3.9.0</note>
    </task>
  </prerequisites>

  <phase_1_style_api_updates>
    <task id="S1" priority="critical">
      <title>Update Style constructor usage</title>
      <description>Replace all Style() with positional arguments to named parameters</description>
      <pattern>
        <old>Style($box.chain..., $text.style...)</old>
        <new>Style.create([$box.color(), $text.style()])</new>
      </pattern>
      <reference>examples.md:29-36</reference>
      <files>
        <file>example/lib/src/common_styles.dart</file>
        <file>example/lib/src/styled_components/*.dart</file>
      </files>
    </task>

    <task id="S2" priority="high">
      <title>Replace .chain pattern</title>
      <description>Remove deprecated .chain usage</description>
      <pattern>
        <old>$box.chain..color(Colors.purple)..borderRadius(8)</old>
        <new>$box.color(Colors.purple), $box.borderRadius(8)</new>
      </pattern>
      <affected_lines>
        <line>example/lib/src/common_styles.dart:7-10</line>
        <line>example/lib/src/common_styles.dart:16-18</line>
        <line>example/lib/src/common_styles.dart:21-23</line>
      </affected_lines>
    </task>

    <task id="S3" priority="high">
      <title>Update context variants ($on)</title>
      <description>Replace $on with new variant system</description>
      <pattern>
        <old>$on.hover($box.color(Colors.blue))</old>
        <new>$box.color(Colors.blue).onHover()</new>
      </pattern>
      <pattern>
        <old>($on.focus | $on.hover)(...)</old>
        <new>MultiVariant([onFocus, onHover], [...])</new>
      </pattern>
      <affected_lines>
        <line>example/lib/src/common_styles.dart:20</line>
        <line>example/lib/src/common_styles.dart:28</line>
        <line>example/lib/src/common_styles.dart:38</line>
      </affected_lines>
      <reference>examples.md:175-181</reference>
    </task>

    <task id="S4" priority="medium">
      <title>Update animate() method</title>
      <description>Update animation API to v2 patterns</description>
      <pattern>
        <old>.animate()</old>
        <new>.animate(.easeInOut(300.ms))</new>
      </pattern>
      <reference>examples.md:175-181</reference>
      <files>
        <file>example/lib/src/common_styles.dart:13,25,41</file>
      </files>
    </task>

    <task id="S5" priority="medium">
      <title>Fix shapeDecoration usage</title>
      <description>Update deprecated shapeDecoration.as() pattern</description>
      <pattern>
        <old>$box.shapeDecoration.as(ShapeDecorationWithPremultipliedAlpha(...))</old>
        <new>$box.decoration(ShapeDecorationWithPremultipliedAlpha(...))</new>
      </pattern>
      <affected_lines>
        <line>example/lib/src/common_styles.dart:29-36</line>
      </affected_lines>
    </task>
  </phase_1_style_api_updates>

  <phase_2_utility_updates>
    <task id="U1" priority="high">
      <title>Update utility patterns to dot notation</title>
      <description>Convert to new dot notation syntax when enabled</description>
      <pattern>
        <old>$box.height(100)..width(100)..color.blue()</old>
        <new>Style.box(.height(100).width(100).color(Colors.blue))</new>
      </pattern>
      <reference>examples.md:29-36, examples.md:161-169</reference>
    </task>

    <task id="U2" priority="medium">
      <title>Update padding/margin utilities</title>
      <description>Use new EdgeInsets patterns</description>
      <pattern>
        <old>$box.padding(8.0, 16.0)</old>
        <new>$box.padding.horizontal(16).vertical(8)</new>
      </pattern>
    </task>

    <task id="U3" priority="medium">
      <title>Update color utilities</title>
      <description>Remove deprecated color methods</description>
      <pattern>
        <old>$box.color.blue()</old>
        <new>$box.color(Colors.blue)</new>
      </pattern>
    </task>
  </phase_2_utility_updates>

  <phase_3_spec_mix_architecture>
    <task id="A1" priority="critical">
      <title>Understand Spec->Mix->Styling pattern</title>
      <description>Each domain follows: Spec (data) -> Mix (builder) -> Styling (with animations)</description>
      <reference>mix-architecture-consolidation-plan.md:9-20</reference>
    </task>

    <task id="A2" priority="high">
      <title>Update imports for consolidated architecture</title>
      <description>Update imports to use new file locations</description>
      <changes>
        <change>Remove iconography imports, use icon</change>
        <change>Remove typography imports, use text</change>
        <change>Update container to box where applicable</change>
      </changes>
      <reference>mix-architecture-consolidation-plan.md:85-96</reference>
    </task>

    <task id="A3" priority="medium">
      <title>Update Mix class usage</title>
      <description>Use proper Mix classes instead of Styling for composition</description>
      <pattern>
        <old>BoxStyling(...)</old>
        <new>BoxMix(...).toStyle()</new>
      </pattern>
      <reference>mix-architecture-consolidation-plan.md:60-62</reference>
    </task>
  </phase_3_spec_mix_architecture>

  <phase_4_token_system>
    <task id="T1" priority="high">
      <title>Update MixScope usage</title>
      <description>Use new MixScope constructor pattern</description>
      <pattern>
        <old>MixScope(data: MixScopeData.static(tokens: {...}))</old>
        <new>MixScope(colors: {...}, spaces: {...}, textStyles: {...})</new>
      </pattern>
      <reference>token-migration-guide.md:559-564</reference>
    </task>

    <task id="T2" priority="medium">
      <title>Update token declarations</title>
      <description>Use specific token types</description>
      <pattern>
        <old>MixToken&lt;Color&gt;('primary')</old>
        <new>ColorToken('primary')</new>
      </pattern>
      <reference>token-migration-guide.md:44-102</reference>
    </task>

    <task id="T3" priority="medium">
      <title>Update token usage in styles</title>
      <description>Use .token() method or call() for refs</description>
      <pattern>
        <old>$box.color(primaryColor)</old>
        <new>$box.color.token(primaryColor)</new>
      </pattern>
      <reference>token-migration-guide.md:249-270</reference>
    </task>

    <task id="T4" priority="low">
      <title>Update shadow tokens to list-based</title>
      <description>BoxShadow and Shadow tokens now use lists</description>
      <pattern>
        <old>BoxShadowToken('shadow'): BoxShadow(...)</old>
        <new>BoxShadowToken('shadow'): [BoxShadow(...)]</new>
      </pattern>
      <reference>token-migration-guide.md:615-630</reference>
    </task>
  </phase_4_token_system>

  <phase_5_widget_updates>
    <task id="W1" priority="high">
      <title>Update Box widget usage</title>
      <description>Ensure Box widgets use updated Style API</description>
      <files>
        <file>lib/src/widgets/common/base_interactive_widget.dart:116-119</file>
