<?xml version="1.0" encoding="UTF-8"?>
<migration_action_plan>
  <metadata>
    <description>Comprehensive migration plan from Mix v1 to Mix v2 for Moon Flutter Core</description>
    <target>Mix v2 (beta from GitHub repository)</target>
    <current_issues>~890 analyzer errors</current_issues>
    <breaking_changes>true</breaking_changes>
  </metadata>

  <phase id="1" name="CLEANUP_AND_PREPARATION" priority="critical">
    <step order="1">
      <action>Remove generated files</action>
      <command>rm -f lib/src/mix/attributes/icon_theme_data_dto.g.dart</command>
      <reason>Mix v2 doesn't use code generation with mix_generator</reason>
    </step>
    
    <step order="2">
      <action>Clean pubspec dependencies</action>
      <files>
        <file>pubspec.yaml</file>
        <file>example/pubspec.yaml</file>
      </files>
      <changes>
        <remove>mix_annotations dependency</remove>
        <remove>mix_generator dev dependency</remove>
        <remove>build_runner dev dependency (if only used for mix)</remove>
      </changes>
    </step>
    
    <step order="3">
      <action>Run flutter clean and pub get</action>
      <commands>
        <command>flutter clean</command>
        <command>flutter pub get</command>
        <command>cd example && flutter pub get</command>
      </commands>
    </step>
  </phase>

  <phase id="2" name="CORE_API_MIGRATION" priority="critical">
    <step order="1">
      <action>Replace Style constructor pattern</action>
      <pattern>
        <old>Style($box.color(Colors.blue), $text.style(someStyle))</old>
        <new>$box.color(Colors.blue).text.style(someStyle)</new>
        <alternative>BoxStyler().color(Colors.blue) for box-only styles</alternative>
      </pattern>
      <files_pattern>**/*.dart</files_pattern>
      <note>Style() constructor with multiple attributes is deprecated. Use chained methods or specific stylers.</note>
    </step>

    <step order="2">
      <action>Replace Spec-based patterns</action>
      <replacements>
        <replace>
          <old>BoxSpec</old>
          <new>BoxMix</new>
        </replace>
        <replace>
          <old>IconSpec</old>
          <new>IconMix</new>
        </replace>
        <replace>
          <old>TextSpec</old>
          <new>TextMix</new>
        </replace>
        <replace>
          <old>FlexSpec</old>
          <new>FlexBoxMix</new>
        </replace>
        <replace>
          <old>BoxSpecAttribute</old>
          <new>BoxMix</new>
        </replace>
        <replace>
          <old>TextSpecAttribute</old>
          <new>TextMix</new>
        </replace>
        <replace>
          <old>FlexSpecAttribute</old>
          <new>FlexBoxMix</new>
        </replace>
      </replacements>
      <note>Spec pattern is replaced with Mix pattern in v2</note>
    </step>

    <step order="3">
      <action>Update widget imports and names</action>
      <replacements>
        <replace>
          <old>HBox</old>
          <new>RowBox</new>
        </replace>
        <replace>
          <old>VBox</old>
          <new>ColumnBox</new>
        </replace>
      </replacements>
    </step>

    <step order="4">
      <action>Update chain getter usage</action>
      <pattern>
        <old>$box.chain</old>
        <new>$box</new>
      </pattern>
      <note>The chain getter is no longer needed in v2</note>
    </step>
  </phase>

  <phase id="3" name="STYLER_PATTERN_MIGRATION" priority="high">
    <step order="1">
      <action>Replace Style() constructors with Styler patterns</action>
      <patterns>
        <pattern>
          <old>Style($box.color(color), $box.padding.all(16))</old>
          <new>BoxStyler().color(color).paddingAll(16)</new>
        </pattern>
        <pattern>
          <old>Style($text.style(textStyle))</old>
          <new>TextStyler().style(textStyle)</new>
        </pattern>
        <pattern>
          <old>Style($icon.size(24))</old>
          <new>IconStyler().size(24)</new>
        </pattern>
      </patterns>
    </step>

    <step order="2">
      <action>Update variant application patterns</action>
      <pattern>
        <old>$on.hover(Style(...))</old>
        <new>.onHovered(BoxStyler()...)</new>
      </pattern>
      <variants>
        <variant old="$on.hover" new=".onHovered"/>
        <variant old="$on.press" new=".onPressed"/>
        <variant old="$on.focus" new=".onFocused"/>
        <variant old="$on.disabled" new=".onDisabled"/>
        <variant old="$on.selected" new=".onSelected"/>
      </variants>
    </step>

    <step order="3">
      <action>Update animation patterns</action>
      <pattern>
        <old>style.animate(duration: 200.ms)</old>
        <new>style.animate(AnimationConfig.easeInOut(200.ms))</new>
      </pattern>
      <note>Animation now requires AnimationConfig objects</note>
    </step>
  </phase>

  <phase id="4" name="TOKEN_SYSTEM_MIGRATION" priority="high">
    <step order="1">
      <action>Update token imports and types</action>
      <note>All tokens are now in package:mix/mix.dart</note>
    </step>

    <step order="2">
      <action>Create token definitions using new types</action>
      <example>
        <old>const token = MixToken&lt;Color&gt;('primary')</old>
        <new>const token = ColorToken('primary')</new>
      </example>
      <token_types>
        <type>ColorToken for colors</type>
        <type>SpaceToken for spacing/sizing (double)</type>
        <type>TextStyleToken for text styles</type>
        <type>RadiusToken for border radius</type>
        <type>BoxShadowToken for shadows (List&lt;BoxShadow&gt;)</type>
      </token_types>
    </step>

    <step order="3">
      <action>Update MixScope usage</action>
      <pattern>
        <old>
          MixScope(
            data: MixScopeData.static(tokens: {...}),
            child: widget,
          )
        </old>
        <new>
          MixScope(
            colors: {colorToken: Colors.blue},
            spaces: {spaceToken: 16.0},
            textStyles: {textToken: TextStyle(...)},
            radii: {radiusToken: Radius.circular(8)},
            child: widget,
          )
        </new>
      </pattern>
    </step>

    <step order="4">
      <action>Update token usage in styles</action>
      <pattern>
        <old>$box.color.token(colorToken)</old>
        <new>$box.color(colorToken())</new>
        <alternative>$box.color.token(colorToken) // still valid</alternative>
      </pattern>
      <note>Token call() method returns refs for direct use</note>
    </step>
  </phase>

  <phase id="5" name="DEPRECATED_API_CLEANUP" priority="medium">
    <step order="1">
      <action>Replace deprecated color methods</action>
      <replacements>
        <replace pattern="\.withOpacity\(([\d.]+)\)" replacement=".withValues(alpha: $1)"/>
        <replace pattern="\.shade(\d+)" replacement=".grey($1)"/>
        <replace pattern="\.alpha" replacement="(color.a * 255.0).round() &amp; 0xff"/>
        <replace pattern="\.red" replacement="(color.r * 255.0).round() &amp; 0xff"/>
        <replace pattern="\.green" replacement="(color.g * 255.0).round() &amp; 0xff"/>
        <replace pattern="\.blue" replacement="(color.b * 255.0).round() &amp; 0xff"/>
        <replace pattern="\.opacity" replacement=".a"/>
      </replacements>
    </step>

    <step order="2">
      <action>Update FlexBox properties</action>
      <replacements>
        <replace old="gap" new="spacing"/>
        <replace old=".spaceBetween" new="(MainAxisAlignment.spaceBetween)"/>
        <replace old=".center" new="(MainAxisAlignment.center)"/>
        <replace old=".start" new="(CrossAxisAlignment.start)"/>
      </replacements>
    </step>

    <step order="3">
      <action>Update deprecated Mix utilities</action>
      <replacements>
        <replace old="MixableDto" new="MixableType"/>
        <replace old="OnContextVariantUtility" new="direct variant methods"/>
        <replace old="scribbleEnabled" new="stylusHandwritingEnabled"/>
      </replacements>
    </step>
  </phase>

  <phase id="6" name="ATTRIBUTE_PATTERN_UPDATE" priority="medium">
    <step order="1">
      <action>Remove attributeOf and resolvableOf patterns</action>
      <pattern>
        <old>style.of(context).attributeOf&lt;BoxSpecAttribute&gt;()</old>
        <new>style.of(context) // returns resolved Mix directly</new>
      </pattern>
    </step>

    <step order="2">
      <action>Update decoration patterns</action>
      <pattern>
        <old>foregroundDecoration/shapeDecoration methods</old>
        <new>decoration(BoxDecorationMix(...))</new>
      </pattern>
    </step>

    <step order="3">
      <action>Update gradient patterns</action>
      <example>
        <old>$box.linearGradient(colors: [...], stops: [...])</old>
        <new>
          BoxStyler().foregroundLinearGradient(
            colors: [...],
            stops: [...],
          )
        </new>
      </example>
    </step>
  </phase>

  <phase id="7" name="ANIMATION_SYSTEM_UPDATE" priority="low">
    <step order="1">
      <action>Update animation configurations</action>
      <patterns>
        <pattern>
          <old>animate(duration: Duration(milliseconds: 200))</old>
          <new>animate(AnimationConfig.easeInOut(200.ms))</new>
        </pattern>
        <pattern name="spring">
          <new>AnimationConfig.springWithDampingRatio(duration, ratio: 0.5)</new>
        </pattern>
        <pattern name="curve">
          <new>CurveAnimationConfig(duration: 200.ms, curve: Curves.easeOut)</new>
        </pattern>
      </patterns>
    </step>

    <step order="2">
      <action>Update keyframe animations</action>
      <note>Use keyframeAnimation() with KeyframeTrack for complex animations</note>
    </step>

    <step order="3">
      <action>Update phase animations</action>
      <note>Use phaseAnimation() for state-based multi-phase animations</note>
    </step>
  </phase>

  <phase id="8" name="TESTING_AND_VALIDATION" priority="critical">
    <step order="1">
      <action>Run analyzer after each phase</action>
      <command>flutter analyze</command>
      <expected>Decreasing error count after each phase</expected>
    </step>

    <step order="2">
      <action>Run tests</action>
      <commands>
        <command>flutter test</command>
        <command>cd example && flutter test</command>
      </commands>
    </step>

    <step order="3">
      <action>Test example app</action>
      <commands>
        <command>cd example && flutter run</command>
      </commands>
      <validate>All components render correctly with Mix v2</validate>
    </step>

    <step order="4">
      <action>Format code</action>
      <command>dart format .</command>
    </step>
  </phase>

  <best_practices>
    <practice>
      <name>Use Styler pattern over Style constructor</name>
      <example>BoxStyler().color(Colors.blue) instead of Style($box.color(Colors.blue))</example>
    </practice>
    
    <practice>
      <name>Prefer typed token classes</name>
      <example>ColorToken('primary') instead of MixToken&lt;Color&gt;('primary')</example>
    </practice>
    
    <practice>
      <name>Use typed MixScope parameters</name>
      <example>MixScope(colors: {...}, spaces: {...}) instead of tokens: {...}</example>
    </practice>
    
    <practice>
      <name>Chain style methods fluently</name>
      <example>BoxStyler().color(Colors.blue).padding(16).borderRounded(8)</example>
    </practice>
    
    <practice>
      <name>Use AnimationConfig for all animations</name>
      <example>AnimationConfig.easeInOut(200.ms) instead of raw duration</example>
    </practice>
  </best_practices>

  <common_patterns>
    <pattern name="Box styling">
      <v1>Style($box.color(Colors.blue), $box.padding.all(16))</v1>
      <v2>BoxStyler().color(Colors.blue).paddingAll(16)</v2>
    </pattern>
    
    <pattern name="Text styling">
      <v1>Style($text.style(TextStyle(...)))</v1>
      <v2>TextStyler().style(TextStyle(...))</v2>
    </pattern>
    
    <pattern name="Flex styling">
      <v1>Style($flex.gap(8), $flex.mainAxisAlignment.spaceBetween())</v1>
      <v2>FlexBoxStyler().spacing(8).mainAxisAlignment(MainAxisAlignment.spaceBetween)</v2>
    </pattern>
    
    <pattern name="Variants">
      <v1>$on.hover(Style(...))</v1>
      <v2>.onHovered(BoxStyler()...)</v2>
    </pattern>
    
    <pattern name="Animations">
      <v1>.animate(duration: 200.ms)</v1>
      <v2>.animate(AnimationConfig.easeInOut(200.ms))</v2>
    </pattern>
  </common_patterns>

  <notes>
    <note priority="high">
      The $on variant utility is completely removed in v2. Use direct methods like .onHovered(), .onPressed() etc.
    </note>
    <note priority="high">
      The chain getter is removed. Use $box directly instead of $box.chain
    </note>
    <note priority="medium">
      Shadow tokens now use List types (List&lt;BoxShadow&gt; instead of BoxShadow)
    </note>
    <note priority="medium">
      Consider removing historical cruft and simplifying widget implementations during migration
    </note>
    <note priority="low">
      Extension methods on Duration (like 200.ms) are available from Mix
    </note>
  </notes>
</migration_action_plan>