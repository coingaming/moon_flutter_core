  <automation_hints>
    <hint>Use regex patterns for bulk replacements</hint>
    <hint>Process files in dependency order (utils -> widgets -> examples)</hint>
    <hint>Create checkpoint commits after each phase</hint>
    <hint>Run analyzer frequently to catch issues early</hint>
    <hint>Reference .llms/mix-context7.md for detailed Mix v2 patterns when needed</hint>
  </automation_hints>

  <critical_patterns>
    <pattern id="CP1">
      <name>Style Creation</name>
      <v1>Style($box.chain..., $text.style...)</v1>
      <v2>Style.create([$box.color(), $text.style()])</v2>
      <alternative_v2>Style.box(.color(Colors.blue).padding(16))</alternative_v2>
    </pattern>

    <pattern id="CP2">
      <name>Context Variants</name>
      <v1>$on.hover($box.color(Colors.blue))</v1>
      <v2>$box.color(Colors.blue).onHover()</v2>
      <note>$on is completely removed in v2</note>
    </pattern>

    <pattern id="CP3">
      <name>Chaining</name>
      <v1>$box.chain..color()..padding()</v1>
      <v2>$box.color(), $box.padding()</v2>
      <note>.chain is deprecated, use separate utilities</note>
    </pattern>

    <pattern id="CP4">
      <name>Animation</name>
      <v1>.animate()</v1>
      <v2>.animate(.easeInOut(Duration(milliseconds: 300)))</v2>
      <note>Animation now requires explicit configuration</note>
    </pattern>

    <pattern id="CP5">
      <name>Mix Composition</name>
      <v1>BoxMix().merge(otherMix)</v1>
      <v2>BoxMix().size(200, 200).merge(elevated)</v2>
      <reference>api-composition-guidelines.md:61-64</reference>
    </pattern>
  </critical_patterns>

